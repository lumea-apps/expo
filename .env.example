# Nouri works offline out of the box (demo brain). To use Claude, set ONE of these:

# Recommended: your own proxy that forwards to https://api.anthropic.com and adds the API key server-side
EXPO_PUBLIC_NOURI_API_URL=

# Local prototyping only — EXPO_PUBLIC_* values are embedded in the app bundle
EXPO_PUBLIC_ANTHROPIC_API_KEY=
